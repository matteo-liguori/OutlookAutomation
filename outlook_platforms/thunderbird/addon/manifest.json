{
  "manifest_version": 2,
  "name": "OutlookAutomation Thunderbird Bridge",
  "version": "0.2.8",
  "description": "Local harness commands for Thunderbird mail. Calendar support is an optional build.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-pilot@outlookautomation.local",
      "strict_min_version": "159.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "compose",
    "compose.send",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
